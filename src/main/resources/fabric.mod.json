{
  "schemaVersion": 1,
  "id": "panorama_window",
  "version": "${version}",
  "name": "PanoramaWindow",
  "description": "Real-time 360 degree panorama rendered into a separate window.",
  "authors": [
    "malken21"
  ],
  "contact": {
    "repo": "https://github.com/malken21/PanoramaWindow"
  },
  "license": "MIT",
  "icon": "assets/panorama_window/icon.png",
  "environment": "client",
  "mixins": [
    "panorama_window.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "marumasa.panorama_window.client.PanoramaWindowClient"
    ],
    "main": [
      "marumasa.panorama_window.PanoramaWindow"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  }
}
